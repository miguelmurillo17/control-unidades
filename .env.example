# Copia este archivo como .env y ajusta los valores. El .env no se versiona.

# Obligatoria cuando DJANGO_DEBUG=False. Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True para desarrollo local, False en produccion.
DJANGO_DEBUG=True

# Dominios permitidos, separados por coma. Requerido cuando DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Base de datos. Por defecto sqlite3 (desarrollo local).
# Para Postgres: DB_ENGINE=postgresql y las variables DB_* siguientes.
DB_ENGINE=sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
